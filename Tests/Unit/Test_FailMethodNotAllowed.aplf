 r←Test_FailMethodNotAllowed dummy;router;req;result
 ⍝ OnFailFn builds the body of Stark's 405; Allow is already set when it runs
 router←⎕NEW #.Stark
 router.Handlers←#.Mocks.MockHandlers
 router.OnFailFn←'FailBody'
 '/items' router.Get 'ListItems'
 req←⎕NEW #.Mocks.MockRequest ('DELETE' '/items')
 result←router._Dispatch req
 r←(405=req.Response.Status)∧('method_not_allowed'≡result.reason)∧('Method Not Allowed'≡result.inner.detail)
 r∧←(⊂'Allow' 'GET')∊↓req.Response.Headers
