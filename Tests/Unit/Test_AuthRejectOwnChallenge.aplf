 router←#.Mocks.NewAuthRouter
 '/me' router.Get ('WhoAmI' (security:,(strictAuth:⍬)))
 req←⎕NEW #.Mocks.MockRequest ('GET' '/me' (1 2⍴'Authorization' 'Bearer ownheader'))
