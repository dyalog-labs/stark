 r←Test_FailNoCredential dummy;router;req;result
 ⍝ A request with no credential reaches OnFailFn with reason no_credential, the schemes, and Stark's challenge already set
 router←#.Mocks.NewAuthRouter
 router.OnFailFn←'FailBody'
 '/me' router.Get ('WhoAmI' (security:(bearerAuth:⍬)(apiKey:⍬)))
 req←⎕NEW #.Mocks.MockRequest ('GET' '/me')
 result←router._Dispatch req
 r←(401=req.Response.Status)∧('no_credential'≡result.reason)∧('Not authenticated'≡result.inner.detail)
 r∧←('apiKey' 'bearerAuth'≡{⍵[⍋⍵]}#.Mocks.LastFail.schemes)
 r∧←(⊂'WWW-Authenticate' 'Bearer')∊↓req.Response.Headers
