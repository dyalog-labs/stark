:Namespace MockHandlers
⍝ Handler functions used by unit tests.

    ∇ result←ListItems req
      result←(items: 'a' 'b' ⋄ total: 2)
    ∇

    ∇ result←GetItem req
      result←(id: req.PathParams.id)
    ∇

    ∇ result←CreateItem req
      req.SetStatus 201
      result←req.Payload
    ∇

    ∇ result←UpdateItem req
      result←(updated: 1)
    ∇

    ∇ result←DeleteItem req
      result←(deleted: 1)
    ∇

    ∇ result←SearchItems req;q
      q←req.QueryParams ⎕VGET ⊂(,'q') ''
      result←(query: q)
    ∇

    ∇ result←GetSpecialItem req
      result←(special: 1)
    ∇

    ∇ result←GetInvoice req
      result←(cust: req.PathParams.cust_id ⋄ inv: req.PathParams.inv_id)
    ∇

    ∇ result←BrokenHandler req
      ⎕SIGNAL ⊂('EN' 11)('Message' 'deliberate error for testing')
    ∇

    ∇ result←err HandleError req
      result←(EN: err.EN ⋄ message: err.Message)
    ∇

    ⍝ Security hooks: called as  user←auth Hook req

    ∇ user←auth CheckBearer req
      :Select auth.credential
      :Case 'good' ⋄ user←(name: 'alice')
      :Case 'forbidden' ⋄ req.Fail 403 ⋄ user←0
      :Else ⋄ user←0
      :EndSelect
    ∇

    ∇ user←auth CheckKey req
      user←(1+auth.credential≡'key123')⊃0 'service'
    ∇

    ∇ user←auth CheckBasic req
      user←(1+auth.credential≡'alice' 'secret')⊃0 'alice'
    ∇

    ∇ user←auth CheckStrict req
      ⍝ Rejects with auth.Reject in different ways depending on the token
      :Select auth.credential
      :Case 'expired' ⋄ user←auth.Reject (detail: 'Token expired' ⋄ code: 'token_expired')
      :Case 'scope' ⋄ user←403 auth.Reject (detail: 'Missing scope')
      :Case 'badstatus' ⋄ user←200 auth.Reject (detail: 'nope')
      :Case 'ownheader'
          'WWW-Authenticate' req.SetHeader 'Bearer error="invalid_token"'
          user←auth.Reject (detail: 'Invalid token')
      :Else ⋄ user←0
      :EndSelect
    ∇

    ∇ user←auth RecordAuth req
      #.Mocks.LastAuth←auth
      user←'recorded'
    ∇

    ∇ user←auth BrokenHook req
      ⎕SIGNAL ⊂('EN' 11)('Message' 'deliberate hook error')
    ∇

    ∇ body←fail FailBody req
      ⍝ OnFailFn: records fail, and wraps Stark's default body
      #.Mocks.LastFail←fail
      body←(reason: fail.reason ⋄ inner: fail.body)
    ∇

    ∇ body←fail BrokenFailFn req
      ⎕SIGNAL ⊂('EN' 11)('Message' 'deliberate OnFailFn error')
    ∇

    ∇ result←WhoAmI req
      result←(user: req.User)
    ∇

:EndNamespace
